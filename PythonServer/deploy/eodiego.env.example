# Production systemd EnvironmentFile (/etc/eodiego/eodiego.env, 0600); no export, substitutions or inline comments.
USE_MOCK=false
KTO_SERVICE_KEY=
KTO_BASE_URL=https://apis.data.go.kr/B551011/KorService2
KTO_CONGESTION_BASE_URL=https://apis.data.go.kr/B551011/TatsCnctrRateService
KTO_CONTENT_TYPE_ID=12
KTO_NUM_OF_ROWS=20
MAX_DETAIL_BATCH=10
KTO_TIMEOUT_SECONDS=5
KTO_MAX_RETRY=1
MAX_CANDIDATES=20
KTO_MAX_CONCURRENCY=10
KTO_DAILY_QUOTA=1000

# Enable after verifying API billing/quota; false uses the existing fallback.
USE_LLM=false
LLM_API_KEY=
LLM_MODEL=gpt-5.4-mini
LLM_REASONING_EFFORT=none
LLM_MAX_OUTPUT_TOKENS=1500
LLM_TIMEOUT_SECONDS=20
LLM_DAILY_REQUEST_LIMIT=45
LLM_MAX_RETRIES=0
LLM_OVERVIEW_MAX_CHARS=400

A_BASE_URL=http://127.0.0.1:8000
B_BASE_URL=http://127.0.0.1:8001
C_BASE_URL=http://127.0.0.1:8002
B_TIMEOUT_SECONDS=30
UPSTREAM_TIMEOUT_SECONDS=90

DB_HOST=
DB_PORT=3306
DB_NAME=eodiego
DB_USER=eodiegoServer
DB_PASSWORD=
# Optional: AWS RDS CA bundle, readable by the service account.
# DB_SSL_CA=/etc/eodiego/global-bundle.pem

SESSION_COOKIE_NAME=session_id
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=https://eodiego-jeju.duckdns.org
# Reuse the existing random secret; ASCII, at least 32 characters.
BFF_GATEWAY_TOKEN=
