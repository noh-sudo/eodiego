# 로컬 실행용 환경변수 템플릿 (cp .env.example .env 후 bash scripts/run_local.sh)

# --- B: 한국관광공사 OpenAPI -------------------------------------------------
# true = mock 데이터, false = 실제 관광공사 API 호출 (KTO_SERVICE_KEY 필요)
USE_MOCK=true

# 공공데이터포털에서 발급받은 서비스키
KTO_SERVICE_KEY=

# endpoint
KTO_BASE_URL=https://apis.data.go.kr/B551011/KorService2
KTO_CONGESTION_BASE_URL=https://apis.data.go.kr/B551011/TatsCnctrRateService

# 위치기반 검색 조건
KTO_CONTENT_TYPE_ID=
KTO_NUM_OF_ROWS=
# 상세정보 일괄 조회 상한 (관광지 1곳당 API 2회: 공통정보 + 소개정보)
MAX_DETAIL_BATCH=

# 실제 API는 mock보다 느리므로 타임아웃/후보 수는 여유 있게
KTO_TIMEOUT_SECONDS=
KTO_MAX_RETRY=
MAX_CANDIDATES=
# 관광공사 API에 동시에 열어둘 연결 수
KTO_MAX_CONCURRENCY=

# 일일 호출 한도 (0이면 추적 안 함, 호출 수는 MySQL kto_api_call에 기록)
KTO_DAILY_QUOTA=

# --- C: AI 일정 생성 ---------------------------------------------------------
# false 면 LLM 없이 규칙 기반 + 기본 문구로만 동작
USE_LLM=false
# OpenAI API 키
LLM_API_KEY=
LLM_MODEL=

LLM_REASONING_EFFORT=none
LLM_MAX_OUTPUT_TOKENS=
LLM_TIMEOUT_SECONDS=

LLM_DAILY_REQUEST_LIMIT=

LLM_MAX_RETRIES=
# 근거 자료로 넣는 소개문 길이 상한
LLM_OVERVIEW_MAX_CHARS=
# C(및 A)가 B를 호출할 때의 타임아웃
B_TIMEOUT_SECONDS=

# --- D: BFF ------------------------------------------------------------------
# D가 A/B/C를 호출할 때의 타임아웃
UPSTREAM_TIMEOUT_SECONDS=

# --- A: 인증/저장 ------------------------------------------------------------
# 쿠키 인증용이라 정확한 origin 명시 ("*" 금지)
ALLOWED_ORIGINS=

# --- MySQL (A/B/C 공통) -------------------------------------------------------
# 앱 계정은 SELECT/INSERT 전용 (테이블·계정은 관리자가 db/*.sql로 생성)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# RDS에 TLS로 접속할 때 인증서 번들 경로
# DB_SSL_CA=

# --- 배포 보안 ---------------------------------------------------------------
# 세션 유지 기간(초), D의 브라우저 쿠키 max_age로도 사용
SESSION_TTL_SECONDS=
# HTTPS로 서비스하면 반드시 true
COOKIE_SECURE=
COOKIE_SAMESITE=
# 화면(worker/dev 프록시)만 D를 부를 수 있게 하는 공유 시크릿
BFF_GATEWAY_TOKEN=

# --- 화면(ui) --------------------------------------------------------------
# vite dev 서버와 worker가 /ui/* 를 넘길 D의 주소
BFF_BASE_URL=
